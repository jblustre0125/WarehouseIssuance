
# Warehouse private files
<FilesMatch "^(?:central-session\.php|database\.local\.php|\.user\.ini|\.nbc-central-disabled)$">
    Require all denied
</FilesMatch>
# BEGIN NBC CENTRAL
<IfModule php_module>
    php_value auto_prepend_file "C:/Xampp/htdocs/WarehouseIssuance/central-session.php"
</IfModule>
<FilesMatch "^(?:central-session\.php|database\.local\.php|\.user\.ini|\.nbc-central-disabled)$">
    Require all denied
</FilesMatch>
# END NBC CENTRAL

# Warehouse-owned SSO switch
<Files ".warehouse-sso-disabled">
    Require all denied
</Files>
